ted . In addition , a host of other equipment such as grapnels were also confiscated . This is the fifth successful anti - piracy operation conducted by Sukanya , in the course of her ongoing patrol mission in the Gulf of Aden , which commenced in September . So far , the Indian Navy has confiscated 14 AK 47 Rifles , 31 magazines and 923 rounds of ammunition from pirates .", "gold": [["6", "causes", "7"], ["2", "causes", "3"], ["3", "causes", "5"], ["2", "causes", "7"], ["5", "causes", "4"], ["6", "causes", "3"], ["7", "causedby", "6"], ["3", "causedby", "2"], ["5", "causedby", "3"], ["7", "causedby", "2"], ["4", "causedby", "5"], ["3", "causedby", "6"]], "lang": "eng", "mentions": ["7", "1", "2", "6", "8", "3", "4", "5"], "surfaces": {"7": "pins down", "1": "face - off", "2": "deployed", "6": "patrols", "8": "under control", "3": "thwarted", "4": "attack", "5": "rescued"}, "sentence_of": {"7": 1, "1": 1, "2": 3, "6": 3, "8": 3, "3": 3, "4": 3, "5": 3}, "first_token": {"7": 51, "1": 57, "2": 77, "6": 82, "8": 88, "3": 98, "4": 103, "5": 109}, "pair_list": [["4", "5"], ["1", "7"], ["2", "5"], ["6", "3"], ["5", "8"], ["4", "7"], ["8", "4"], ["6", "4"], ["8", "2"], ["5", "6"], ["5", "4"], ["2", "8"], ["6", "2"], ["5", "7"], ["8", "3"], ["6", "7"], ["7", "4"], ["7", "3"], ["2", "1"], ["5", "1"], ["4", "2"], ["7", "2"], ["5", "2"], ["4", "8"], ["2", "4"], ["4", "1"], ["1", "8"], ["3", "2"], ["7", "8"], ["3", "4"], ["3", "7"], ["2", "6"], ["7", "6"], ["7", "5"], ["2", "3"], ["3", "1"], ["6", "5"], ["4", "3"], ["1", "4"], ["1", "3"], ["5", "3"], ["7", "1"], ["8", "5"], ["4", "6"], ["8", "1"], ["3", "6"], ["2", "7"], ["6", "8"], ["6", "1"], ["8", "6"], ["1", "5"], ["3", "8"], ["1", "2"], ["3", "5"], ["1", "6"], ["8", "7"]], "tokens": ["http", ":", "/", "/", "www", ".", "rediff", ".", "com", "/", "news", "/", "slide", "-", "show", "/", "slide", "-", "show", "-", "1", "-", "must", "-", "see", "-", "navy", "-", "pins", "-", "down", "-", "somali", "-", "pirates", "-", "in", "-"